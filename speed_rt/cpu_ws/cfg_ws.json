{
 "what": "SPEED-RT CPU harness config for the Windows CPU host (WSL2 distro); paths are inside the distro's tmpfs",
 "root": "/dev/shm/srt",
 "python": "/dev/shm/srt/venv/bin/python",
 "vars": {"code": "/dev/shm/srt/code", "data": "/dev/shm/srt/data", "relay": "/dev/shm/srt/relay",
          "handoff": "/dev/shm/srt/handoff"},
 "env": {"LD_LIBRARY_PATH": "{root}/lib", "LC_ALL": "C.UTF-8", "TZ": "UTC0"},
 "ref": {"cwd": "{code}", "env": {"PYTHONPATH": "{code}/surface_v2:{code}", "PYTHONDONTWRITEBYTECODE": "1"},
         "argv": ["{py}", "-m", "timing.cpu_term", "ref", "--plain", "--d", "9", "--val", "{data}/val", "--rep", "{rep}",
                  "--core", "{core}", "--out", "{out}"]},
 "filler": {"cwd": "{code}", "env": {"PYTHONPATH": "{code}/surface_v2:{code}", "PYTHONDONTWRITEBYTECODE": "1"},
            "argv": ["{py}", "{root}/cpu_ws/filler.py", "{data}/val"]},
 "slots": "auto",
 "max_attempts": 3,
 "save_to": "%USERPROFILE%\\speedrt_out",
 "handoff_from": "%USERPROFILE%\\speedrt_in",
 "limits": {"ref_rel": 1.10, "ref_spread": 1.06, "slots_max": 8}
}
