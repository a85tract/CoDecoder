#!/bin/bash
#PBS -A <account>
#PBS -q main
#PBS -l job_priority=regular
#PBS -l select=1:ncpus=128:mem=235GB
#PBS -l walltime=04:00:00
#PBS -j oe
# Gross's full-DEM Relay-BP read of the re-test's test4 set on Derecho (RETEST.md section 3.1), as stage 4's jobs
# (gross_stage4/.../bb/scripts/derecho/cpu_s4_a.pbs) but in the regular main queue (stage 4: the develop queue):
# bb.stage4_gross fullread on CHUNKS, one shot per task, saved every ~60 s and resumed by a resubmission; with OPP=1
# first sector Relay-BP and BP-OSD on all 15 chunks (bb.opp), as stage 4's job A. Code at $R/code (git archive of the
# freeze commit), shots and the draw's manifest at $R/out (copied from Alpine; file sha256 = the manifest), blind.
#   qsub -N rt_g4a -v R=<cluster-scratch>/retest/run,CHUNKS=0-4,OPP=1 gross_full_derecho.pbs
set -euo pipefail
T=$R/code; O=$R/out
cd $T/bb/gross_stage4/ising_compare
export PYTHONPATH=$T/bb/gross_stage4/ising_compare:$T/bb/gross_stage4/qldpc_neural OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 \
  MKL_NUM_THREADS=1 RAYON_NUM_THREADS=1 PYTHONUNBUFFERED=1 QND_RELAY=<cluster-work>/qldpc/relay BB_SHOTS=$O/shots \
  BB_PREDS=$O/preds RT_MANIFEST=$O/manifest_gross.csv
PY=<cluster-work>/qldpc/venv/bin/python; S=$T/retest/shim/rt_bb.py
mkdir -p $O/preds $O/rows
hostname; date; lscpu | grep "Model name"
if [ "${OPP:-0}" = 1 ] && [ ! -f $O/preds/bb144_p0.004_test40014_bposd.npz ]; then
  $PY $S bb.opp --code bb144 --p 0.004 --split test4 --chunks 0-14 --dec relay,bposd --procs 128 \
    --out $O/rows/opp_gross_sector_bposd.csv | grep -v "^relay \|^bposd "
fi
$PY $S bb.stage4_gross fullread --split test4 --chunks $CHUNKS --procs 128 --out $O/rows/opp_gross_full_$CHUNKS.csv
date; echo JOBDONE
